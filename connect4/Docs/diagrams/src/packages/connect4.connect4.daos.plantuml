@startuml connect4.connect4.daos

class Session as "models.Session"
class Game as "models.Game"
class Coordinate as "utils.models.Coordinate"

class daos.SessionDAO {

+ {static} EXTENSION : String
+ {static} DIRECTORY : Path
+ {static} directory : File
- session : SessionDAO
- gameDAO : GameDAO
+ associate(Session)
+ save()
+ save(name: String)
- createFilewriter(name: String) : FileWriter
- createBufferedReader(name: String) : BufferedReader
- closeFilewriter(fileWriter: FileWriter)
- closeBufferedReader(BufferedReader)
+ exists(name: String) : boolean
+ hasSavedGames() : boolean
+ load(name: String)

}

interface daos.DAO {
    + final EOL : String
    + save(Filewriter)
    + load(BufferedReader)
}

class daos.GameDAO {

   - game : Game
   - boardDAO : BoardDAO
   - turnDAO : TurnDAO
   + save(Filewriter)
   + load(BufferedReader)
}


class daos.BoardDAO {

    - game : Game
    + save(Filewriter)
    - saveBoard(Filewriter)
    - saveLastDrop(Filewriter)
    + load(BufferedReader)
    - loadBoard(BufferedReader)
    - loadLastDrop(BufferedReader)
}


class daos.TurnDAO {

    - game : Game
    + save(Filewriter)
    - saveActivePlayer(Filewriter)
    - savePlayersSize(Filewriter)
    - savePlayers(Filewriter)
    + load(BufferedReader)
    - loadActivePlayer(BufferedReader)
}

class daos.PlayerDAO {

    - game : Game
    + save(Filewriter)
    + load(BufferedReader)
}

SessionDAO --> Session
SessionDAO --> GameDAO
DAO <|.. GameDAO
DAO <|.. BoardDAO
DAO <|.. TurnDAO
DAO <|.. PlayerDAO
GameDAO --> Game
GameDAO *--> BoardDAO
GameDAO *--> TurnDAO
BoardDAO ..> Coordinate
TurnDAO ..> PlayerDAO
BoardDAO --> Game
TurnDAO --> Game
PlayerDAO --> Game

@enduml