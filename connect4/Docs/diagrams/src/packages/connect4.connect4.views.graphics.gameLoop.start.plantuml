@startuml connect4.connect4.views.graphics.start

class StartController as "controllers.\nStartController"
abstract class GameLoopView as "graphics.\ngameLoop\nGameLoopView"

class start.StartPanelView {
    +write()
    +addPlayers()
    -writeNewGameMenu()
    -writeOpenGameMenu()
}

StartPanelView --> StartController
GameLoopView <|-- StartPanelView

@enduml