@startuml connect4.connect4.controllers


interface controllers.AcceptorController {
    +accept(ControllerVisitor)
}

class controllers.Logic {
    -controllers : Map<StateValue, AceptorController> 
    +Logic()
    +getController() : AceptorController
}

abstract class controllers.Controller {
    +Controller(Session)
    +nextState()
}

class controllers.StartController {

    +getPlayerTypes() : PlayerType[]
    +getNumberPlayers() : int
    +reset()
    +isReset() : boolean
    +addPlayer(PlayerType)
    +getMinMaxMachinePlayerType() : PlayerType
    +getRandomMachinePlayerType() : PlayerType
    +getUserPlayerPlayerType() : PlayerType
}

interface controllers.ControllerVisitor {
    +start(StartController)
    +play(PlayController)
    +resume(ResumeController)
}

class controllers.PlayController{
    +getActivePlayer() : Player
    +getActivePlayerType() : PlayerType
    +getColor(Coordinate) : Color
    +isFinished() : boolean
    +next()
    +dropToken(int)
    +getColumn() : int
    +isWinner() : boolean
    +undo()
    +undoable() : boolean
    +redo()
    +redoable() : boolean
    +registerMemento()
}

class controllers.ActionController{
    +getActivePlayer() : Player
    +getActivePlayerType() : PlayerType
    +getColor(Coordinate) : Color
    +isFinished() : boolean
    +next()
    +dropToken(int)
    +getColumn() : int
    +isWinner() : boolean
    +registerMemento()
}

class controllers.UndoController{
    +undo()
    +undoable() : boolean
}

class controllers.RedoController{
    +redo()
    +redoable() : boolean
}

class controllers.ResumeController{
    +isWinner() : boolean
    +reset()
}

class Session as "models.Session"
class StateValue as "types.StateValue"



Controller ..> ControllerVisitor
Controller <|-- StartController
Controller <|-- PlayController
Controller <|-- ActionController
Controller <|-- UndoController
Controller <|-- RedoController
Controller <|-- ResumeController
AcceptorController <|.. StartController
AcceptorController <|.. PlayController
AcceptorController <|.. ResumeController

Logic *--> Session
Logic *--> Controller
Logic *--> StateValue

Controller --> Session

PlayController *--> ActionController
PlayController *--> UndoController
PlayController *--> RedoController


@enduml