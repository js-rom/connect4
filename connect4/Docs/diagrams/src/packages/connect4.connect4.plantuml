@startuml connect4.connect4

@startuml connect4.connect4

interface Logic as "controllers\n.core\n.Logic" <<abstractProduct>> 
class LogicImplementation as "controllers\n.implementation\n.LogicImplementation" <<concreteProduct>>
Logic <|-- LogicImplementation

class ConsoleView as "views.ConsoleView" <<ConcreteProduct>>
class GraphicsView as "views.GraphicsView" <<ConcreteProduct>>
interface View as "views.View" <<abstractProduct>>

package "launchers" {

    abstract class launchers.Connect4 <<creator>> {
        - LauncherProvider launcherProvider
        + Connect4()
        # {abstract}createLauncherProvider() : LauncherProvider
        # {abstract} PlayGames()
    }
    
    package standalone {
    
        class ConsoleConnect4 <<concreteCreator>> {
            {static}+main(String[])
        }
        
        class GraphicsConnect4 <<concreteCreator>> {
            {static}+main(String[])
        }
    
    }
    
        package distributed {
        
            package client {
                class ConsoleConnect4 <<concreteCreator>> {
                    {static}+main(String[])
                }
        
                class GraphicsConnect4 <<concreteCreator>> {
                    {static}+main(String[])
                }
                
                class LogicProxy <<concreteProduct>>
            }
            package server {
                class Connect4Server
            }
    
    }
    
    launchers.Connect4 <|-- standalone.ConsoleConnect4
    launchers.Connect4 <|-- standalone.GraphicsConnect4
    launchers.Connect4 <|-- distributed.client.ConsoleConnect4
    launchers.Connect4 <|-- distributed.client.GraphicsConnect4

    package launcherProviders {
        
        interface LauncherProvider <<abstractFactory>> {
            + getController() : Controller
            + getView() : View
        }
        
        class StandaloneConsole <<concreteFactory>> {}
        class DistributedConsole <<concreteFactory>>
        class StandaloneGraphics <<concreteFactory>>
        class DistributedGraphics <<concreteFactory>>
        
        LauncherProvider <|-- StandaloneConsole
        LauncherProvider <|-- DistributedConsole
        LauncherProvider <|-- StandaloneGraphics
        LauncherProvider <|-- DistributedGraphics
    
         Logic <|-- LogicProxy

         View <|-- ConsoleView
         View <|-- GraphicsView
         
         StandaloneConsole ..> LogicImplementation
         StandaloneConsole ..> ConsoleView
         
         DistributedConsole ..> LogicProxy
         DistributedConsole ..> ConsoleView
         
         StandaloneGraphics ..> LogicImplementation
         StandaloneGraphics ..> GraphicsView
         
         DistributedGraphics ..> LogicProxy
         DistributedGraphics ..> GraphicsView
         
    }
    
    standalone.ConsoleConnect4 *--> launcherProviders.LauncherProvider
    standalone.GraphicsConnect4 *--> launcherProviders.LauncherProvider
    distributed.client.ConsoleConnect4 *--> launcherProviders.LauncherProvider
    distributed.client.GraphicsConnect4 *--> launcherProviders.LauncherProvider
    
}

@enduml

@enduml