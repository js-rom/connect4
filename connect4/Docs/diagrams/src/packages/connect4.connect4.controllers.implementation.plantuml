@startuml connect4.connect4.controllers.implementation

package implementation {

}

class implementation.Logic {
    -controllers : Map<StateValue, AceptorController> 
    +Logic()
    +getController() : AceptorController
}


class implementation.StartController {

}


class implementation.PlayController{

}

class implementation.ActionController{
   
}

class implementation.UndoController{
  
}

class implementation.RedoController{
   
}

class implementation.SaveController{
  - sessionDAO : SessionDAO
  + SaveController(Session, SessionDAO)
}

class implementation.ResumeController{
  
}

class Session as "models.Session"
class SessionDAO as "daos.SessionDAO"
class StateValue as "types.StateValue"

interface AcceptorController as "controllers.core.\nAcceptorController"
AcceptorController <|.. StartController
AcceptorController <|.. PlayController
AcceptorController <|.. SaveController
AcceptorController <|.. ResumeController

abstract class coreLogic as "controllers.core.Logic"
coreLogic <|-- Logic
Logic *--> Session
Logic --> SessionDAO
Logic *--> StartController
Logic *--> PlayController
Logic *--> SaveController
Logic *--> ResumeController
Logic *--> StateValue

PlayController *--> ActionController
PlayController *--> UndoController
PlayController *--> RedoController

abstract class StartController as "controllers.core.\nStartController"
abstract class PlayController as "controllers.core.\nPlayController"
abstract class SaveController as "controllers.core.\nSaveController"
abstract class ResumeController as "controllers.core.\nResumeController"

StartController <|-- implementation.StartController
PlayController <|-- implementation.PlayController
SaveController <|-- implementation.SaveController
ResumeController <|-- implementation.ResumeController

implementation.SaveController --> Session
implementation.PlayController --> Session
implementation.SaveController --> Session
implementation.ResumeController --> Session
implementation.SaveController --> SessionDAO

@enduml