@startuml connect4.connect4.views.graphics.play

class PlayPanelViewVisitor as "graphics.\nplay.\ncommands.\nPlayPanelViewVisitor"
class NextTurnCommand as "graphics.\nplay.\ncommands.\nNextTurnCommand"
class RedoMachinePlayerCommand as "graphics.\nplay.\ncommands.\nRedoMachinePlayerCommand"
class RedoUserPlayerCommand as "graphics.\nplay.\ncommands.\nRedoUserPlayerCommand"
class UndoMachinePlayerCommand as "graphics.\nplay.\ncommands.\nUndoMachinePlayerCommand"
class UndoUserPlayerCommand as "graphics.\nplay.\ncommands.\nUndoUserPlayerCommand"
class RedoCommand as "graphics.\nplay.\ncommands.\nRedoCommand"
class UndoCommand as "graphics.\nplay.\ncommands.\nUndoCommand"

abstract class GameLoopView as "graphics.\ngameLoop.\nGameLoopView"
interface PlayPanelViewVisitor as "grapgics.\nplay.\ncommands.\nPlayPanelViewVisitor"
class CountDownLatch as "java.util.\nconcurrent.\nCountDownLatch"
class PlayController as "controllers.\nPlayController"
abstract class BoardView as "grapgics.\nplay.\nboard.\nBoardView"
abstract class BoardViewPrototypeDirector as "grapgics.\nplay.\nboard.\nBoardViewPrototypeDirector"
abstract class BoardViewPrototypeRegistry as "grapgics.\nplay.\nboard.\nBoardViewPrototypeRegistry"


class play.PlayPanelView{
    +write()
    -removeBoard()
    +visit(MachinePlayerBoardView)
    +visit(UserPlayerBoardView)
    +interruptDropToken()
    +undoable()
    +undo()
    +redo()
}

class play.TurnView{
    +write()
    +setUndoCommand(UndoComand)
    +setRedoCommand(RedoComand)
}

class play.TurnViewFactory{
    +createMachineTurnView(PlayPanelViewVisitor)
    +createUserTurnView(PlayPanelViewVisitor)
}

class play.BoardViewFactory{
    +createMachineBoardView(PlayPanelViewVisitor)
}

PlayPanelView --> PlayController
PlayPanelView --> CountDownLatch
GameLoopView <|-- PlayPanelView
PlayPanelViewVisitor <|.. PlayPanelView
PlayPanelView *--> BoardView
TurnView --> PlayController
TurnView --> UndoCommand
TurnView --> RedoCommand
PlayPanelView *--> TurnView
PlayPanelView ..> TurnViewFactory
PlayPanelView ..> BoardViewFactory
BoardViewFactory ..> BoardViewPrototypeRegistry
BoardViewFactory ..> BoardViewPrototypeDirector
BoardViewFactory ..> NextTurnCommand
TurnViewFactory --> PlayController
TurnViewFactory ..> RedoMachinePlayerCommand
TurnViewFactory ..> RedoUserPlayerCommand
TurnViewFactory ..> UndoMachinePlayerCommand
TurnViewFactory ..> UndoUserPlayerCommand


@enduml