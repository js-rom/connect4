@startuml connect4.net

package net as "connect4.connect4.net" {
    interface Operations {
        + send(PlayerType)
        + send(PlayerType[])
        +send(Color)
        + receivePlayerTypes() : PlayerType[]
        + receiveColor() : Color
    }
    class Client {
    }
    class Server {
    }
    class CharactersTcpiSocket {

    }
}

class Client as "connect4.utils.net.Client"
class Server as "connect4.utils.net.Server"
class CharactersTcpiSocket as "connect4.utils.net.CharactersTcpiSocket"

Operations <|.. net.Client
Operations <|.. net.Server
Operations <|.. net.CharactersTcpiSocket
net.Client *--> net.CharactersTcpiSocket
net.Server *--> net.CharactersTcpiSocket
CharactersTcpiSocket <|-- net.CharactersTcpiSocket
Client <|-- net.Client
Server <|-- net.Server

@enduml