@startuml connect4.connect4.launchers

interface Logic as "controllers\n.core\n.Logic" <<abstractProduct>>
class LogicImplementation as "controllers\n.implementation\n.LogicImplementation" <<concreteProduct>>
Logic <|.. LogicImplementation
class LogicProxy as "controllers\n.proxy\n.LogicProxy" <<concreteProduct>>
Logic <|.. LogicProxy

class ConsoleView as "views.ConsoleView" <<ConcreteProduct>>
interface View as "views.View" <<abstractProduct>>
View <|.. ConsoleView

class SessionDAOFiles as "persistence.files.SessionDAO"
class SessionDAObbdd as "persistence.bbdd.SessionDAO"

package "launchers" {

    abstract class launchers.Connect4 <<creator>> {
        # logic: Logic
        # view: View
        - viewsMap : Map<String, View>
        # usageMsg : String
        # Connect4()
        # play()
        # configure()
        # PlayGames()

    }

    package standalone {

        class Connect4  {
            - sessionDAOMap : Map<String, SessionDAO>
            {override} configure()
            {static}+main(String[])
        }

    }

    Connect4 <|-- standalone.Connect4

    package distributed {

        package client {
            class Connect4{
                {static}+main(String[])
            }
        }

        package server {

            class Server {
                - logic: LogicImplementation
                - sessionDAO : SessionDAO
                - sessionDAOMap : Map<String, SessionDAO>
                - configure()
                - serve()
                {static}+main(String[])
            }
        }


    }

    launchers.Connect4 <|-- distributed.client.Connect4
    

}

launchers.Connect4 *--> Logic
launchers.Connect4 *--> View


launchers.standalone.Connect4 --> SessionDAOFiles
launchers.standalone.Connect4 --> SessionDAObbdd
launchers.distributed.server.Server --> SessionDAOFiles
launchers.distributed.server.Server --> SessionDAObbdd
launchers.distributed.client.Connect4 --> LogicProxy
launchers.standalone.Connect4 --> LogicImplementation


@enduml